@@ -8,13 +8,25 @@
 #define _EVL_WORK_H
 
 #include <linux/irq_work.h>
+#include <linux/llist.h>
 #include <linux/workqueue.h>
 #include <evl/flag.h>
 
 struct evl_element;
 
+/*
+ * Relay state of an evl_work on its way to the in-band stage, same
+ * protocol as IRQ_WORK_PENDING/IRQ_WORK_BUSY: PENDING is set while
+ * the work sits on a per-CPU relay list, BUSY until the relay
+ * handler is done with it.
+ */
+#define EVL_WORK_PENDING	BIT(0)
+#define EVL_WORK_BUSY		BIT(1)
+#define EVL_WORK_CLAIMED	(EVL_WORK_PENDING|EVL_WORK_BUSY)
+
 struct evl_work {
-	struct irq_work irq_work;
+	struct llist_node relay_node; /* on per-CPU relay list */
+	atomic_t relay_flags;	      /* EVL_WORK_PENDING|BUSY */
 	struct work_struct wq_work;
 	struct workqueue_struct *wq;
 	union {
@@ -26,7 +38,7 @@ struct evl_work {
 
 #define EVL_DEFINE_WORK(__work, __handler)				\
 	struct evl_work __work = {					\
-		.irq_work = IRQ_WORK_INIT(__evl_do_irq_work),		\
+		.relay_flags = ATOMIC_INIT(0),				\
 		.wq_work = __WORK_INITIALIZER((__work).wq_work,		\
 					__evl_do_work),			\
 		.wq = NULL,						\
@@ -43,7 +55,7 @@ struct evl_sync_work {
 #define EVL_DEFINE_SYNC_WORK(__work, __handler)				\
 	struct evl_sync_work __work = {					\
 		.work = {						\
-			.irq_work = IRQ_WORK_INIT(__evl_do_irq_work),	\
+			.relay_flags = ATOMIC_INIT(0),			\
 			.wq_work = __WORK_INITIALIZER((__work).work.wq_work, \
 						__evl_do_sync_work),	\
 			.wq = NULL,					\
@@ -72,17 +84,19 @@ static inline bool evl_call_inband(struct evl_work *work)
 	return evl_call_inband_from(work, system_wq);
 }
 
+void evl_sync_relay(struct evl_work *work);
+
 static inline
 void evl_flush_work(struct evl_work *work)
 {
-	irq_work_sync(&work->irq_work);
+	evl_sync_relay(work);
 	flush_work(&work->wq_work);
 }
 
 static inline
 void evl_cancel_work(struct evl_work *work)
 {
-	irq_work_sync(&work->irq_work);
+	evl_sync_relay(work);
 	cancel_work_sync(&work->wq_work);
