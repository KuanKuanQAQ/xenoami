+/*
+ * Dovetail hook, called in-band with filp->f_lock held after
+ * fcntl(F_SETFL) or ioctl(FIONBIO) changed filp->f_flags. f_lock
+ * serializes concurrent updates of the mirror.
+ */
+void handle_inband_fflags_change(struct file *filp)
+{
+	struct evl_file *efilp = filp->f_oob_state.data;
+
+	if (efilp)
+		WRITE_ONCE(efilp->nonblock, !!(filp->f_flags & O_NONBLOCK));
+}
