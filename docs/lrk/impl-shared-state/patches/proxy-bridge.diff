diff --git a/kernel/evl/proxy_gate.h b/kernel/evl/proxy_gate.h
new file mode 100644
index 000000000000..a8e9f0eaca6f
--- /dev/null
+++ b/kernel/evl/proxy_gate.h
@@ -0,0 +1,74 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0
+ *
+ * Boundary between the EVL side of a proxy (proxy.c) and its
+ * in-band, Linux side (proxy_bridge.c).
+ *
+ * proxy_bridge.c only includes this header: struct evl_proxy is
+ * opaque there, so the Linux side can reach the EVL state of a
+ * proxy through the gates declared below only.
+ */
+
+#ifndef _EVL_PROXY_GATE_H
+#define _EVL_PROXY_GATE_H
+
+#include <linux/types.h>
+#include <linux/poll.h>
+
+struct file;
+struct vm_area_struct;
+struct evl_proxy;		/* EVL side, opaque to proxy_bridge.c */
+struct proxy_bridge;		/* Linux side, opaque to proxy.c */
+
+/*
+ * Gates: implemented by proxy.c, called by proxy_bridge.c. None of
+ * them sleeps or depends on any Linux lock.
+ */
+
+/* Find the Linux side of the proxy open on @filp. */
+struct proxy_bridge *proxy_gate_bridge(struct file *filp);
+
+/* Both stages: copy into / out of the rings. */
+ssize_t proxy_gate_write(struct file *filp, const char __user *u_buf,
+			size_t count, bool *kick);
+bool proxy_gate_can_write(struct evl_proxy *proxy, size_t size);
+ssize_t proxy_gate_read(struct file *filp, char __user *u_buf,
+			size_t count);
+
+/* Output ring: the Linux side is the consumer. */
+unsigned int proxy_gate_out_fill(struct evl_proxy *proxy);
+unsigned int proxy_gate_out_consume(struct evl_proxy *proxy,
+				unsigned int n);
+void proxy_gate_out_done(struct evl_proxy *proxy, unsigned int remaining);
+
+/* Input ring: the Linux side is the producer. */
+unsigned int proxy_gate_in_fill(struct evl_proxy *proxy);
+void proxy_gate_in_request(struct evl_proxy *proxy, unsigned int n);
+unsigned int proxy_gate_in_requested(struct evl_proxy *proxy);
+void proxy_gate_in_produce(struct evl_proxy *proxy, unsigned int n);
+unsigned int proxy_gate_in_fulfil(struct evl_proxy *proxy, unsigned int n);
+void proxy_gate_in_stop(struct evl_proxy *proxy,
+			unsigned int fulfilled, ssize_t ret);
+bool proxy_gate_in_done(struct evl_proxy *proxy, bool exception);
+bool proxy_gate_in_take_eof(struct evl_proxy *proxy);
+
+/*
+ * Bridge: implemented by proxy_bridge.c, called by proxy.c (factory,
+ * relay work, file operations).
+ */
+struct proxy_bridge *proxy_bridge_create(struct evl_proxy *proxy,
+					struct file *filp,
+					void *out_mem, void *in_mem,
+					unsigned int bufsz,
+					unsigned int granularity);
+void proxy_bridge_destroy(struct proxy_bridge *br);
+void proxy_bridge_relay_output(struct proxy_bridge *br);
+void proxy_bridge_relay_input(struct proxy_bridge *br);
+ssize_t proxy_bridge_write(struct file *filp, const char __user *u_buf,
+			size_t count, loff_t *ppos);
+ssize_t proxy_bridge_read(struct file *filp, char __user *u_buf,
+			size_t count, loff_t *ppos);
+__poll_t proxy_bridge_poll(struct file *filp, poll_table *wait);
+int proxy_bridge_mmap(struct file *filp, struct vm_area_struct *vma);
+
+#endif /* !_EVL_PROXY_GATE_H */
