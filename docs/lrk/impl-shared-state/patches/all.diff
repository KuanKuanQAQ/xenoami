index 000000000000..bd7e29bf9692
--- /dev/null
+++ b/kernel/evl/proxy_bridge.c
@@ -0,0 +1,331 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0
+ *
+ * Copyright (C) 2019 Philippe Gerum  <rpm@xenomai.org>
+ *
+ * Linux side of the EVL proxy: the relay workers moving data between
+ * the rings and the proxied file, and the in-band file operations.
+ * All of this runs in-band only. The EVL state of the proxy is
+ * reached through the gates declared in proxy_gate.h exclusively.
+ */
+
+#include <linux/types.h>
+#include <linux/slab.h>
+#include <linux/kernel.h>
+#include <linux/file.h>
+#include <linux/fs.h>
+#include <linux/mm.h>
+#include <linux/wait.h>
+#include <linux/mutex.h>
+#include <linux/poll.h>
+#include "proxy_gate.h"
+
+/* Linux side of one ring. */
+struct proxy_relay {
+	void *bufmem;		/* Shared data area. */
+	unsigned int bufsz;	/* Snapshot, immutable. */
+	unsigned int granularity; /* Snapshot, immutable. */
+	unsigned int off;	/* Output: rdoff, input: wroff. */
+	struct mutex worker_lock;
+	wait_queue_head_t inband_wait;
+};
+
+/* Linux side of one proxy. */
+struct proxy_bridge {
+	struct evl_proxy *proxy; /* Opaque, only passed to the gates. */
+	struct file *filp;	/* Proxied file, reference held by proxy.c. */
+	bool has_out, has_in;
+	struct proxy_relay out, in;
+};
+
+static void relay_output(struct proxy_bridge *br)
+{
+	struct proxy_relay *rl = &br->out;
+	unsigned int rdoff, count, len, n;
+	struct file *filp = br->filp;
+	loff_t pos, *ppos;
+	ssize_t ret = 0;
+
+	mutex_lock(&rl->worker_lock);
+
+	count = proxy_gate_out_fill(br->proxy);
+	rdoff = rl->off;
+
+	ppos = NULL;
+	if (filp->f_mode & FMODE_ATOMIC_POS) {
+		mutex_lock(&filp->f_pos_lock);
+		ppos = &pos;
+		pos = filp->f_pos;
+	}
+
+	while (count > 0 && ret >= 0) {
+		len = count;
+		do {
+			if (rdoff + len > rl->bufsz)
+				n = rl->bufsz - rdoff;
+			else
+				n = len;
+
+			if (rl->granularity > 0)
+				n = min(n, rl->granularity);
+
+			ret = kernel_write(filp, rl->bufmem + rdoff, n, ppos);
+			if (ret >= 0 && ppos)
+				filp->f_pos = *ppos;
+			len -= n;
+			rdoff = (rdoff + n) % rl->bufsz;
+		} while (len > 0 && ret > 0);
+		/*
+		 * On error, the portion we failed writing is
+		 * lost. Fair enough.
+		 */
+		count = proxy_gate_out_consume(br->proxy, count);
+	}
+
+	if (ppos)
+		mutex_unlock(&filp->f_pos_lock);
+
+	rl->off = rdoff;
+
+	mutex_unlock(&rl->worker_lock);
+
+	/*
+	 * Since we are running in-band, make sure to give precedence
+	 * to oob waiters for wakeups: the gate notifies them first.
+	 */
+	proxy_gate_out_done(br->proxy, count);
+	if (count < rl->bufsz)
+		wake_up(&rl->inband_wait);
+}
+
+static void relay_input(struct proxy_bridge *br)
+{
+	struct proxy_relay *rl = &br->in;
+	unsigned int wroff, count, len, n;
+	struct file *filp = br->filp;
+	bool exception = false;
+	loff_t pos, *ppos;
+	ssize_t ret = 0;
+
+	mutex_lock(&rl->worker_lock);
+
+	count = proxy_gate_in_requested(br->proxy);
+	wroff = rl->off;
+
+	ppos = NULL;
+	if (filp->f_mode & FMODE_ATOMIC_POS) {
+		mutex_lock(&filp->f_pos_lock);
+		ppos = &pos;
+		pos = filp->f_pos;
+	}
+
+	while (count > 0) {
+		len = count;
+		do {
+			if (wroff + len > rl->bufsz)
+				n = rl->bufsz - wroff;
+			else
+				n = len;
+
+			if (rl->granularity > 0)
+				n = min(n, rl->granularity);
+
+			ret = kernel_read(filp, rl->bufmem + wroff, n, ppos);
+			if (ret <= 0) {
+				proxy_gate_in_stop(br->proxy, count - len, ret);
+				exception = true;
+				goto done;
+			}
+
+			if (ppos)
+				filp->f_pos = *ppos;
+
+			proxy_gate_in_produce(br->proxy, ret);
+			len -= ret;
+			wroff = (wroff + n) % rl->bufsz;
+		} while (len > 0);
+		count = proxy_gate_in_fulfil(br->proxy, count);
+	}
+done:
+	if (ppos)
+		mutex_unlock(&filp->f_pos_lock);
+
+	rl->off = wroff;
+
+	mutex_unlock(&rl->worker_lock);
+
+	if (proxy_gate_in_done(br->proxy, exception))
+		wake_up(&rl->inband_wait);
+}
+
+/* Relay work handlers, called by proxy.c. */
+
+void proxy_bridge_relay_output(struct proxy_bridge *br)
+{
+	relay_output(br);
+}
+
+void proxy_bridge_relay_input(struct proxy_bridge *br)
+{
+	relay_input(br);
+}
+
+/* In-band file operations. */
+
+ssize_t proxy_bridge_write(struct file *filp, const char __user *u_buf,
+			size_t count, loff_t *ppos)
+{
+	struct proxy_bridge *br = proxy_gate_bridge(filp);
+	bool kick;
+	ssize_t ret;
+
+	if (!br->has_out)
+		return -ENXIO;
+
+	do {
+		ret = proxy_gate_write(filp, u_buf, count, &kick);
+		if (kick) {
+			/*
+			 * The ring went from empty to non-empty:
+			 * relay synchronously from the caller's
+			 * context.
+			 */
+			relay_output(br);
+			return ret;
+		}
+		if (ret != -EAGAIN || filp->f_flags & O_NONBLOCK)
+			break;
+		ret = wait_event_interruptible(br->out.inband_wait,
+				proxy_gate_can_write(br->proxy, count));
+	} while (!ret);
+
+	return ret;
+}
+
+ssize_t proxy_bridge_read(struct file *filp, char __user *u_buf,
+			size_t count, loff_t *ppos)
+{
+	struct proxy_bridge *br = proxy_gate_bridge(filp);
+	bool request_done = false;
+	ssize_t ret;
+
+	if (!br->has_in)
+		return -ENXIO;
+
+	if (count == 0)
+		return 0;
+
+	for (;;) {
+		ret = proxy_gate_read(filp, u_buf, count);
+		if (ret || filp->f_flags & O_NONBLOCK)
+			break;
+		if (!request_done) {
+			proxy_gate_in_request(br->proxy, count);
+			request_done = true;
+		}
+		relay_input(br);
+		if (proxy_gate_in_take_eof(br->proxy)) {
+			ret = 0;
+			break;
+		}
+	}
+
+	return ret;
+}
+
+__poll_t proxy_bridge_poll(struct file *filp, poll_table *wait)
+{
+	struct proxy_bridge *br = proxy_gate_bridge(filp);
+	__poll_t ret = 0;
+
+	if (br->has_out) {
+		poll_wait(filp, &br->out.inband_wait, wait);
+		if (proxy_gate_out_fill(br->proxy) < br->out.bufsz)
+			ret = POLLOUT|POLLWRNORM;
+	}
+
+	if (br->has_in) {
+		poll_wait(filp, &br->in.inband_wait, wait);
+		if (proxy_gate_in_fill(br->proxy) > 0)
+			ret |= POLLIN|POLLRDNORM;
+	}
+
+	if (br->filp->f_op->poll)
+		ret |= br->filp->f_op->poll(br->filp, wait);
+
+	return ret;
+}
+
+int proxy_bridge_mmap(struct file *filp, struct vm_area_struct *vma)
+{
+	struct proxy_bridge *br = proxy_gate_bridge(filp);
+	struct file *mapfilp = br->filp;
+	int ret;
+
+	if (mapfilp->f_op->mmap == NULL)
+		return -ENODEV;
+
+	vma->vm_file = get_file(mapfilp);
+
+	/*
+	 * Since the mapper element impersonates a different file, we
+	 * need to swap references: if the mapping call fails, we have
+	 * to drop the reference on the target file we just took on
+	 * entry; if it succeeds, then we have to drop the reference
+	 * on the mapper file do_mmap_pgoff() acquired before calling
+	 * us.
+	 */
+	ret = call_mmap(mapfilp, vma);
+	if (ret)
+		fput(mapfilp);
+	else
+		fput(filp);
+
+	return ret;
+}
+
+/* Creation and disposal, called by the proxy factory (in-band). */
+
+static void init_relay(struct proxy_relay *rl, void *bufmem,
+		unsigned int bufsz, unsigned int granularity)
+{
+	rl->bufmem = bufmem;
+	rl->bufsz = bufsz;
+	rl->granularity = granularity;
+	rl->off = 0;
+	mutex_init(&rl->worker_lock);
+	init_waitqueue_head(&rl->inband_wait);
+}
+
+struct proxy_bridge *proxy_bridge_create(struct evl_proxy *proxy,
+					struct file *filp,
+					void *out_mem, void *in_mem,
+					unsigned int bufsz,
+					unsigned int granularity)
+{
+	struct proxy_bridge *br;
+
+	br = kzalloc(sizeof(*br), GFP_KERNEL);
+	if (br == NULL)
+		return NULL;
+
+	br->proxy = proxy;
+	br->filp = filp;
+
+	if (out_mem) {
+		br->has_out = true;
+		init_relay(&br->out, out_mem, bufsz, granularity);
+	}
+
+	if (in_mem) {
+		br->has_in = true;
+		init_relay(&br->in, in_mem, bufsz, granularity);
+	}
+
+	return br;
+}
+
+void proxy_bridge_destroy(struct proxy_bridge *br)
+{
+	kfree(br);
+}
